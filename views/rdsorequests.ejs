<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>User Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
    position: relative;
    background-color: #e8f5e9; /* No background on the main body */
    display: flex;
    flex-direction: column;
    font-family: 'Arial', sans-serif;
}

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        
        url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2220%22 height=%2220%22 viewBox=%220 0 20 20%22%3E%3Cpath fill=%22%23e0e0e0%22 d=%22M0 0h2v2H0zm2 2h2v2H2zm2 2h2v2H4zm2 2h2v2H6zm2 2h2v2H8zm2 2h2v2H10zm2 2h2v2H12zm2 2h2v2H14z%22/%3E%3C/svg%3E') repeat;
    background-size: 450px, 30px 30px; /* Larger checkered pattern for a more refined look */
    background-position: center, 0 0; /* Logo stays centered, checkered pattern starts at the top */
    opacity: 0.9; /* Slightly faded to make it softer */
    z-index: -1; /* Place it behind other content */
    animation: fadeAnimation 15s ease-in-out infinite, moveCheckered 10s linear infinite; /* Fading + vertical move */
}

/* Keyframes for fading effect */
@keyframes fadeAnimation {
    0%, 100% { opacity: 0.9; } /* Keep the opacity at a subtle level */
    50% { opacity: 0.4; }   /* Faded in the middle for a smooth transition */
}

/* Keyframes for moving only the checkered pattern vertically */
@keyframes moveCheckered {
    0% { background-position: center, 0 0; }  /* Start at the top */
    100% { background-position: center, 0 100%; }  /* Move to the bottom */
}

        .header {
            background: linear-gradient(90deg, #008000, #66bb6a);
            color: white;
            padding: 0.75rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            font-size: 1rem;
        }

        .header .brand {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .header .btn-profile,
        .header .btn-logout {
            background-color: #ffffff;
            color: #2e7d32;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
            margin-right: 10px;
        }

        .header .btn-profile:hover,
        .header .btn-logout:hover {
            background-color: #f1f1f1;
            color: #2e7d32;
        }

        .dashboard-container {
            margin-top: 60px;
            display: flex;
            flex-wrap: wrap;
        }
        .sidebar {
            width: 220px;
            background-color: #66bb6a;
            padding-top: 15px;
            position: fixed;
            top: 60px;
            left: 0;
            height: calc(100% - 60px);
            overflow-y: auto;
            z-index: 900;
        }

        .sidebar a {
    display: flex;
    align-items: center;
    color: white;
    padding: 0.8rem;
    text-decoration: none;
    font-size: 1rem;
    transition: background-color 0.3s ease, color 0.15s ease; /* Faster color transition */
}

/* Ensure both icon and text get the hover effect */
.sidebar a i, 
.sidebar a span {
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), color 0.15s ease; /* Faster color transition */
    display: inline-block; /* Smooth scaling */
}

/* Add spacing between icon and text */
.sidebar a i {
    margin-right: 12px; /* Adjust as needed */
    font-size: 1.2rem;  /* Slightly larger for balance */
}

/* More subtle enlarge & push to right effect, plus color change */
.sidebar a:hover {
    color: rgb(255, 255, 255); /* Change text & icon color */
}

.sidebar a:hover i, 
.sidebar a:hover span {
    transform: scale(1.08) translateX(4px); /* Gentle scaling & movement */
}

        .main-content {
            margin-left: 220px; /* Increased to account for the sidebar */
            padding: 1.5rem;
            flex-grow: 1;
            width: 100%;
        }

        .welcome {
            font-size: 1.5rem;
            color: #2e7d32;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .card {
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }

        canvas {
            width: 100% !important;
            height: 300px !important;
        }

        .card-title {
            margin-bottom: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .my-4 {
            font-size: large;
        }

        /* Scrolling Sections */
        .chart-section {
            margin-bottom: 2rem;
            padding: 1rem;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow: auto; /* Allow both horizontal and vertical scrolling */
            max-height: 400px; /* Limit the height of the chart section */
        }

        /* Ensure responsiveness */
        @media (max-width: 768px) {
            .dashboard-container {
                flex-direction: column;
                gap: 1rem;
            }

            .sidebar {
                position: static;
                height: auto;
                width: 100%;
                padding: 0;
                display: flex;
                justify-content: space-around;
            }

            .sidebar a {
                padding: 1rem;
            }

            .main-content {
                margin-left: 0;
            }
        }
    </style>
    <style>
       /* General Card Styles */
.card {
    padding: 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    text-align: center;
    display: flex;               /* Allow the content to stretch */
    flex-direction: column;      /* Align items vertically */
    justify-content: space-between; /* Allow items to spread out */
    flex-grow: 1;                /* Allow the card to grow */
}

/* Color Specific Styles */
.total-research {
    background-color: #ffffff; /* Blue */
    color: black;
}

.proposed-research {
    background-color: #ffffff; /* Yellow */
    color: black;
}

.completed-research {
    background-color: #ffffff; /* Green */
    color: black;
}

.ongoing-research {
    background-color: #ffffff; /* Purple */
    color: black;
}

.published-research {
    background-color: #ffffff; /* Indigo */
    color: black;
}

/* Responsive Grid Layout */
.grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
}

@media (min-width: 768px) {
    .grid {
        grid-template-columns: repeat(2, 1fr);
    }
}




    </style>
    <style>
    /* Add a smooth animation when loading the table */
@keyframes fadeIn {
    0% {
        opacity: 0;
        transform: translateY(20px);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

.table-container {
    animation: fadeIn 0.5s ease-in-out;
}

/* Style for the table */
.table {
    border-collapse: collapse;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    background-color: #fff;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    margin-top: 30px;
}

/* Header Styling */
.table thead {
    background-color: #007bff;
    color: white;
    font-weight: bold;
}

.table th,
.table td {
    padding: 12px 15px;
    text-align: center;
    font-size: 0.8rem;
}

.table tbody tr {
    transition: background-color 0.3s ease;
}

.table tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.1);
}

/* Button Styling */
.btn-xs {
    font-size: 0.7rem;
    padding: 0.3rem 0.5rem;
    border-radius: 5px;
    transition: transform 0.2s ease-in-out;
}

.btn-xs:hover {
    transform: translateY(-2px);
}

/* For better form design */
form {
    display: inline;
}

.d-flex {
    display: flex;
    justify-content: center;
    gap: 10px;
}

/* Table cells animation */
.table td {
    opacity: 0;
    animation: fadeIn 0.5s ease-in-out forwards;
}

.table td:nth-child(odd) {
    animation-delay: 0.2s;
}

.table td:nth-child(even) {
    animation-delay: 0.4s;
}

/* Pending Requests Heading Styling */
.pending-requests {
    font-size: 1.5rem; /* Balanced size */
    font-weight: bold;
    color: #2e7d32; /* Deep orange to indicate pending status */
    display: flex;
    align-items: center;
    gap: 10px; /* Space between icon and text */
    opacity: 0;
    transform: translateY(-10px);
    animation: fadeSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Icon Styling */
.pending-requests i {
    font-size: 1.75rem; /* Slightly larger for emphasis */
    color: #2e7d32; /* Matches text */
    opacity: 0;
    transform: scale(0.8);
    animation: popIn 0.4s ease-out 0.2s forwards;
}

/* Smooth Fade & Slide Animation (Telegram Vibe) */
@keyframes fadeSlideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Pop-in Effect for Icon */
@keyframes popIn {
    0% {
        opacity: 0;
        transform: scale(0.8);
    }
    100% {
        opacity: 1;
        transform: scale(1);
    }
}



    </style>
</head>
<body>

<div class="header">
    <div class="brand" style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: white;">
            <img src="/images/essu_logo.png" alt="ESSU Logo" style="width: 100%; height: auto; object-fit: contain;">
        </div>
        ESSU RIMS
    </div>
    <div class="d-flex">
        
        <button class="btn-logout" onclick="window.location.href='/logout'">Logout</button>
    </div>
</div>

<div class="dashboard-container">
    <div class="sidebar">
        <a href="/rdsodashboard"><i class="fas fa-tachometer-alt"></i> <span>Dashboard</span></a>
        <a href="/rdsopapers"><i class="fas fa-file-alt"></i> <span>Researches</span></a>
        <a href="/campusescolleges"><i class="fas fa-university"></i> <span>Campuses & Colleges</span></a>
        <a href="/faculties"><i class="fas fa-user-graduate"></i> <span>Faculties/Researchers</span></a>
        <a href="/requests"><i class="fas fa-envelope"></i> <span>Verification Requests</span></a>
    </div>
    

    <div class="main-content">
        <h2 class="pending-requests">
            <i class="fas fa-hourglass-half"></i> Pending Requests
        </h2>

        <% if (pendingUsersAndFaculty.length === 0) { %>
            <p>No pending requests</p>
        <% } else { %>
        
        <!-- Improved Table (with responsive design) -->
        <div class="table-container">
            <table class="table table-striped table-hover table-bordered text-center align-middle fs-7">
                <thead class="table-success">
                    <tr>
                        <th>RIMS ID</th>
                        <th>Full Name</th>
                        <th>Campus</th>
                        <th>College</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% pendingUsersAndFaculty.forEach(user => { %>
                        <tr>
                            <td><%= user.idnumber %></td>
                            <td><%= user.fullname %></td>
                            <td><%= user.campus || 'N/A' %></td>
                            <td><%= user.college || 'N/A' %></td>
                            <td><%= user.department || 'N/A' %></td>
                            <td><%= user.designation || 'N/A' %></td>
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td>

                                <div class="d-flex justify-content-center gap-1">
                                      <!-- View Button (Triggers Modal) -->
                                <button type="button" class="btn btn-sm btn-info btn-xs" data-bs-toggle="modal" data-bs-target="#viewModal<%= user.idnumber %>">
                                    <i class="fas fa-eye"></i> View
                                </button>
                                    <form action="/approve" method="POST" onsubmit="return confirm('Are you sure you want to approve this user?');">
                                        <input type="hidden" name="idnumber" value="<%= user.idnumber %>">
                                        <button type="submit" class="btn btn-sm btn-success btn-xs">
                                            <i class="fas fa-check"></i> Approve
                                        </button>
                                    </form>
                                    <form action="/reject" method="POST" onsubmit="return confirm('Are you sure you want to reject this user?');">
                                        <input type="hidden" name="idnumber" value="<%= user.idnumber %>">
                                        <button type="submit" class="btn btn-sm btn-danger btn-xs">
                                            <i class="fas fa-times"></i> Reject
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                      <!-- Modal for Viewing User Details -->
                        <div class="modal fade" id="viewModal<%= user.idnumber %>" tabindex="-1" aria-labelledby="viewModalLabel<%= user.idnumber %>" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content animated-modal"> <!-- Added animation class -->
                                    <div class="modal-header">
                                        <h5 class="modal-title text-white" id="viewModalLabel<%= user.idnumber %>">User Details</h5>

                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row">
                                            <!-- Left Column: User Information -->
                                            <div class="col-md-6 animated-content">
                                                <div class="user-details-card p-4">
                                                    <h4 class="text-center mb-4">User Details</h4>
                                                    <div class="user-detail-item">
                                                        <p><strong>RIMS ID:</strong> <span><%= user.idnumber %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>Full Name:</strong> <span><%= user.fullname %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>Campus:</strong> <span><%= user.campus || 'N/A' %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>College:</strong> <span><%= user.college || 'N/A' %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>Department:</strong> <span><%= user.department || 'N/A' %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>Designation:</strong> <span><%= user.designation || 'N/A' %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>Username:</strong> <span><%= user.username %></span></p>
                                                    </div>
                                                    <div class="user-detail-item">
                                                        <p><strong>Email:</strong> <span><%= user.email %></span></p>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <style>
                                                .user-details-card {
                                                    background-color: #f8f9fa;
                                                    border-radius: 10px;
                                                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                                                }
                                            
                                                .user-detail-item {
                                                    margin-bottom: 15px;
                                                }
                                            
                                                .user-detail-item p {
                                                    font-size: 16px;
                                                    color: #333;
                                                }
                                            
                                                .user-detail-item strong {
                                                    color: #007bff;
                                                }
                                            
                                                .user-detail-item span {
                                                    font-weight: 500;
                                                    color: #495057;
                                                }
                                            
                                                .user-detail-item:hover {
                                                    background-color: #e9ecef;
                                                    border-radius: 5px;
                                                    padding: 5px;
                                                    transition: background-color 0.3s ease;
                                                }
                                            
                                                .user-details-card h4 {
                                                    font-size: 1.25rem;
                                                    font-weight: bold;
                                                    color: #007bff;
                                                }

                                                
                                            </style>
                                            

                                            <!-- Right Column: Images -->
                                            <div class="col-md-6 text-center animated-content text-white">
                                                <% if (user.filename) { %>
                                                    <p><strong>Profile Picture:</strong></p>
                                                    <img src="/uploads/<%= user.filename %>" alt="Profile Picture" class="img-fluid rounded mb-2 shadow-sm">
                                                <% } %>

                                                <% if (user.faculty_id_pic) { %>
                                                    <p><strong>Faculty ID:</strong></p>
                                                    <img src="/uploads/<%= user.faculty_id_pic %>" alt="Faculty ID Picture" class="img-fluid rounded mb-2 shadow-sm">
                                                <% } %>

                                                <% if (user.selfie_with_id) { %>
                                                    <p><strong>Selfie with Faculty ID:</strong></p>
                                                    <img src="/uploads/<%= user.selfie_with_id %>" alt="Selfie with ID" class="img-fluid rounded shadow-sm">
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <style>
                        /* Glassmorphism Effect */
                        .animated-modal {
                            background: rgba(255, 255, 255, 0.1);
                            backdrop-filter: blur(12px);
                            border-radius: 15px;
                            border: 1px solid rgba(255, 255, 255, 0.3);
                            box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
                            animation: fadeInScale 0.4s ease-out;
                        }

                        /* Modal Content Slide-in Animation */
                        .animated-content {
                            opacity: 0;
                            transform: translateY(10px);
                            animation: slideUp 0.4s ease-out forwards 0.2s;
                        }

                        /* Animations */
                        @keyframes fadeInScale {
                            0% {
                                opacity: 0;
                                transform: scale(0.95);
                            }
                            100% {
                                opacity: 1;
                                transform: scale(1);
                            }
                        }

                        @keyframes slideUp {
                            0% {
                                opacity: 0;
                                transform: translateY(10px);
                            }
                            100% {
                                opacity: 1;
                                transform: translateY(0);
                            }
                        }

                        /* Smooth Close Button */
                        .btn-close {
                            transition: transform 0.2s ease;
                        }

                        .btn-close:hover {
                            transform: scale(1.1);
                        }

                        /* Image Styling */
                        .img-fluid {
                            transition: transform 0.3s ease, box-shadow 0.3s ease;
                        }

                        .img-fluid:hover {
                            transform: scale(1.05);
                            box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.2);
                        }
                        </style>


                    <% }) %>
                </tbody>
            </table>
        </div>
        
        
        <% } %>
        
        
        
        
        
    </div>
    

        

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
