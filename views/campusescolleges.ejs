<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>User Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            position: relative;
            background-color: #e8f5e9;
            display: flex;
            flex-direction: column;
            font-family: 'Arial', sans-serif;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2220%22 height=%2220%22 viewBox=%220 0 20 20%22%3E%3Cpath fill=%22%23e0e0e0%22 d=%22M0 0h2v2H0zm2 2h2v2H2zm2 2h2v2H4zm2 2h2v2H6zm2 2h2v2H8zm2 2h2v2H10zm2 2h2v2H12zm2 2h2v2H14z%22/%3E%3C/svg%3E') repeat;
            background-size: 450px, 30px 30px;
            background-position: center, 0 0;
            opacity: 0.9;
            z-index: -1;
            animation: fadeAnimation 15s ease-in-out infinite, moveCheckered 10s linear infinite;
        }

        @keyframes fadeAnimation {
            0%, 100% { opacity: 0.9; }
            50% { opacity: 0.4; }
        }

        @keyframes moveCheckered {
            0% { background-position: center, 0 0; }
            100% { background-position: center, 0 100%; }
        }

        .header {
            background: linear-gradient(90deg, #008000, #66bb6a);
            color: white;
            padding: 0.75rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            font-size: 1rem;
        }

        .header .brand {
            font-size: 1.25rem;
            font-weight: 600;
        }

        .header .btn-profile,
        .header .btn-logout {
            background-color: #ffffff;
            color: #2e7d32;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
            margin-right: 10px;
        }

        .header .btn-profile:hover,
        .header .btn-logout:hover {
            background-color: #f1f1f1;
            color: #2e7d32;
        }

        .dashboard-container {
            margin-top: 60px;
            display: flex;
            flex-wrap: wrap;
        }

        .sidebar {
            width: 220px;
            background-color: #66bb6a;
            padding-top: 15px;
            position: fixed;
            top: 60px;
            left: 0;
            height: calc(100% - 60px);
            overflow-y: auto;
            z-index: 900;
        }

        .sidebar {
            width: 220px;
            background-color: #66bb6a;
            padding-top: 15px;
            position: fixed;
            top: 60px;
            left: 0;
            height: calc(100% - 60px);
            overflow-y: auto;
            z-index: 900;
        }

        .sidebar a {
    display: flex;
    align-items: center;
    color: white;
    padding: 0.8rem;
    text-decoration: none;
    font-size: 1rem;
    transition: background-color 0.3s ease, color 0.15s ease; /* Faster color transition */
}

/* Ensure both icon and text get the hover effect */
.sidebar a i, 
.sidebar a span {
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), color 0.15s ease; /* Faster color transition */
    display: inline-block; /* Smooth scaling */
}

/* Add spacing between icon and text */
.sidebar a i {
    margin-right: 12px; /* Adjust as needed */
    font-size: 1.2rem;  /* Slightly larger for balance */
}

/* More subtle enlarge & push to right effect, plus color change */
.sidebar a:hover {
    color: rgb(255, 255, 255); /* Change text & icon color */
}

.sidebar a:hover i, 
.sidebar a:hover span {
    transform: scale(1.08) translateX(4px); /* Gentle scaling & movement */
}
        .main-content {
            margin-left: 220px;
            padding: 1.5rem;
            flex-grow: 1;
            width: 100%;
        }

        .welcome {
            font-size: 1rem;
            color: #2e7d32;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .campus-card {
    height: 150px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    background-color: #ffffff;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;

    /* Start hidden */
    opacity: 0;
    transform: translateY(20px);
}

/* Hover effect */
.campus-card:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.2);
}

/* Telegram-style reveal animation */
@keyframes reveal {
    0% {
        opacity: 0;
        transform: translateY(20px);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}


/* Icon styling */
.campus-card i {
    font-size: 2.5rem;
    color: #66bb6a;
    margin-bottom: 1rem;
}

/* Campus name styling */
.campus-card .campus-name {
    font-size: 1.125rem;
    font-weight: bold;
    color: #2e7d32;
}




.campus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem; /* Reduced gap between cards */
    margin-top: 2rem;
}

@media (min-width: 768px) {
    .campus-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

/* Campus & Colleges Heading Styling */
.campus-colleges {
    font-size: 1.75rem; /* Larger for emphasis */
    font-weight: bold;
    color: #2e7d32; /* Deep green for an academic feel */
    display: flex;
    align-items: center;
    gap: 12px; /* Space between icon and text */
    opacity: 0;
    transform: translateY(-10px);
    animation: fadeSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Icon Styling */
.campus-colleges i {
    font-size: 2rem; /* Bigger for visual balance */
    color: #2e7d32; /* Matches text */
    opacity: 0;
    transform: scale(0.8);
    animation: popIn 0.4s ease-out 0.2s forwards;
}

/* Smooth Fade & Slide Animation (Telegram Vibe) */
@keyframes fadeSlideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Pop-in Effect for Icon */
@keyframes popIn {
    0% {
        opacity: 0;
        transform: scale(0.8);
    }
    100% {
        opacity: 1;
        transform: scale(1);
    }
}


/* Bounce Animation */
@keyframes bounceIn {
    0% {
        transform: scale(0.8);
        opacity: 0;
    }
    50% {
        transform: scale(1.1);
        opacity: 1;
    }
    100% {
        transform: scale(1);
    }
}





/* Modal Background */
.modal {
    display: none; /* Hidden by default */
    position: fixed; /* Stay in place */
    z-index: 1; /* Sit on top */
    left: 0;
    top: 0;
    width: 100%; /* Full width */
    height: 100%; /* Full height */
    overflow: auto; /* Enable scroll if needed */
    background-color: rgba(0, 0, 0, 0.4); /* Black with opacity */
    padding-top: 60px; /* Space from top */
    animation: bounceIn 0.6s ease-out;
}

/* Modal Content */
.modal-content {
    background-color: #fefefe;
    margin: 5% auto;
    padding: 20px;
    border: 1px solid #888;
    width: 80%;
    max-width: 500px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    position: relative; /* Ensure relative positioning for absolute elements */
}

.close {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 24px;
    cursor: pointer;
}

.close:hover,
.close:focus {
    color: black;
    text-decoration: none;
    cursor: pointer;
}

/* Form Styling */
form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

label {
    font-weight: bold;
}





    </style>

    <!-- CSS for Pill Design -->
<style>

    .input-row {
            display: flex;
            gap: 10px; /* Space between inputs */
            justify-content: flex-start;
            align-items: center;
            flex-wrap: wrap;
        }
    
        .small-width {
            flex: 0 1 48%; /* Limits width to 48% for each, adjusting automatically */
            min-width: 200px; /* Prevents shrinking too much */
        }
    
        .input-container {
            display: flex;
            align-items: center;
           
            padding: 10px;
            border-radius: 50px; /* Pill Shape */
            border: 0px solid #ccc;
            margin-bottom: 15px;
            width: 100%;
        }
    
        .dual-input {
            justify-content: space-between;
            padding: 10px 15px;
        }
    
    
       
    
      
    
        
    
        
        .pill-input {
            width: 100%;
            padding: 12px 15px;
            border-radius: 25px;
            border: 1px solid #ccc;
           
            font-size: 16px;
           
            padding-left: 40px;
            transition: all 0.2s ease-in-out;
            margin-left: 20px;
        }
    
        .pill-input:focus {
            border-color: #007BFF;
            background: white;
            box-shadow: 0px 0px 8px rgba(0, 123, 255, 0.3);
        }
    
        
    
        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 12px;
            border-radius: 25px;
            border: none;
            background: #007BFF;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
        }
    
        .btn-submit:hover {
            background: #0056b3;
        }
    
         /* Responsive Adjustments */
         @media (max-width: 600px) {
            .input-row {
                flex-direction: column;
            }
    
            .small-width {
                flex: 1 1 100%; /* Makes it full width on small screens */
            }
        }
    
        
    </style>
</head>
<body>

<div class="header">
    <div class="brand" style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: white;">
            <img src="/images/essu_logo.png" alt="ESSU Logo" style="width: 100%; height: auto; object-fit: contain;">
        </div>
        ESSU RIMS
    </div>
    <div class="d-flex">
        
        <button class="btn-logout" onclick="window.location.href='/logout'">Logout</button>
    </div>
</div>

<div class="dashboard-container">
    <div class="sidebar">
        <a href="/rdsodashboard"><i class="fas fa-tachometer-alt"></i> <span>Dashboard</span></a>
        <a href="/rdsopapers"><i class="fas fa-file-alt"></i> <span>Researches</span></a>
        <a href="/campusescolleges"><i class="fas fa-university"></i> <span>Campuses & Colleges</span></a>
        <a href="/faculties"><i class="fas fa-user-graduate"></i> <span>Faculties/Researchers</span></a>
        <a href="/requests"><i class="fas fa-envelope"></i> <span>Verification Requests</span></a>
    </div>
    

    <div class="main-content">
        
        <h1 class="campus-colleges">
            <i class="fas fa-university"></i> Campus & Colleges
        </h1>
        
        <p>Select campus to set annual target number of research</p>
        <div class="campus-grid">
            <div class="campus-card" data-campus="ESSU MAIN">
                <i class="fas fa-school"></i>
                <div class="campus-name">ESSU MAIN</div>
            </div>
            <div class="campus-card" data-campus="ESSU MAYDOLONG">
                <i class="fas fa-school"></i>
                <div class="campus-name">ESSU MAYDOLONG</div>
            </div>
            <div class="campus-card" data-campus="ESSU SALCEDO">
                <i class="fas fa-school"></i>
                <div class="campus-name">ESSU SALCEDO</div>
            </div>
            <div class="campus-card" data-campus="ESSU GUIUAN">
                <i class="fas fa-school"></i>
                <div class="campus-name">ESSU GUIUAN</div>
            </div>
            <div class="campus-card" data-campus="ESSU CAN-AVID">
                <i class="fas fa-school"></i>
                <div class="campus-name">ESSU CAN-AVID</div>
