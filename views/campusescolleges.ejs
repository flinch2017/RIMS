        <script>
            document.addEventListener("DOMContentLoaded", function () {
    const cards = document.querySelectorAll(".campus-card");

    cards.forEach((card, index) => {
        setTimeout(() => {
            card.style.animation = "reveal 0.4s ease-out forwards";
        }, index * 150); // 150ms delay between each card
    });
});

        </script>
        
       <!-- Add Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<!-- Modal -->
<div id="campusModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <form action="/save-campus-data" method="POST">
            <label for="campus">Set Goal</label>
            <div class="input-container">
                <i class="fa-solid fa-building"></i>
                <input type="text" id="campus" name="campus" readonly class="pill-input" />
            </div>
            <!-- College Selection and Selected College Side by Side -->
<!-- Single Pill for College Selection and Display -->
<div class="input-group">
    <label for="college">College</label>
    <div class="input-container dual-input">
        <i class="fa-solid fa-school"></i>
        <select id="college" name="college" class="pill-input select-box">
            <option value="" disabled selected>Select a college</option>
        </select>
        <input type="text" id="selectedCollege" name="selectedCollege" class="pill-input display-box" required readonly />
    </div>
</div>



          

            <label for="year">Select Year:</label>
            <div class="input-container">
                <i class="fa-solid fa-calendar"></i>
                <input type="number" id="year" name="year" min="2025" max="2030" step="1" value="2025" class="pill-input" required>
            </div>

            <label for="targetResearch">Target Number of Research:</label>
            <div class="input-container">
                <i class="fa-solid fa-bullseye"></i>
                <input type="number" id="targetResearch" name="targetResearch" min="0" placeholder="Enter target number of research" class="pill-input" required>
            </div>

            <button type="submit" class="btn-submit">Save</button>
        </form>
    </div>
</div>




<script>
    // College options based on campus
    const collegesByCampus = {
        "ESSU MAIN": ["Agriculture", "Arts and Sciences", "Business Management and Accountancy", "Computer Studies", "Criminal Justice Education", "Education", "Engineering", "Fisheries and Aquatics Sciences",  "Hospitality Management", "Nursing and Allied Sciences", "Science", "Technology"],
        "ESSU SALCEDO": ["Engineering", "Education", "Nursing and Allied Sciences", "Computer Studies"],
        "ESSU GUIUAN": ["Education", "Hospitality Management", "Criminal Justice Education", "Computer Studies", "Arts and Sciences", "Business Management and Accountancy", "Technology", "Engineering"],
        "ESSU MAYDOLONG": ["Education", "Criminal Justice Education", "Hospitality Management"],
        "ESSU ARTECHE": ["College of Tourism", "College of Marine Sciences"],
        "ESSU BALANGIGA": ["College of Tourism", "College of Marine Sciences"],
        "ESSU CAN-AVID": ["Education", "Agriculture", "Business Management and Accountancy", "Criminal Justice Education", "Computer Studies"]
    };

    document.addEventListener("DOMContentLoaded", function () {
    const campusInput = document.getElementById("campus");
    const collegeSelect = document.getElementById("college");
    const selectedCollegeInput = document.getElementById("selectedCollege"); // New input field

    function updateCollegeOptions() {
        const selectedCampus = campusInput.value.trim();
        collegeSelect.innerHTML = "<option value='' disabled selected>Select a college</option>"; // Reset options

        if (collegesByCampus[selectedCampus]) {
            collegesByCampus[selectedCampus].forEach(college => {
                const option = document.createElement("option");
                option.value = college;
                option.textContent = college;
                collegeSelect.appendChild(option);
            });
        }
    }

    // Update colleges when modal is opened (campus field is already set)
    const modal = document.getElementById("campusModal");
    modal.addEventListener("click", updateCollegeOptions);

    // Also update when the campus field changes (just in case)
    campusInput.addEventListener("input", updateCollegeOptions);

    // Display the selected college in the input field
    collegeSelect.addEventListener("change", function () {
        selectedCollegeInput.value = collegeSelect.value;
    });
});






</script>





        


        

        <script>
            // Get all campus cards and modal elements
const campusCards = document.querySelectorAll('.campus-card');
const modal = document.getElementById('campusModal');
const closeBtn = document.querySelector('.close');
const campusInput = document.getElementById('campus');
const collegeInput = document.getElementById('college');
const yearInput = document.getElementById('year');
const targetResearchInput = document.getElementById('targetResearch');

// Event listener for opening the modal when a campus card is clicked
campusCards.forEach(card => {
    card.addEventListener('click', function () {
        const campusName = card.getAttribute('data-campus');  // Get the campus name from the card
        
        // Set the campus name in the modal input and make it readonly
        campusInput.value = campusName;
        campusInput.setAttribute('readonly', true);  // Make it readonly
        
        // Clear and focus on the editable fields
        collegeInput.value = '';  // Reset College input
        
        // Reset the target research input to default
        targetResearchInput.value = '';  // Set to empty string or a default value if needed
        
        // Reset the year selection to default
        yearInput.value = "2025";  // Set default year (can change if needed)
        
        // Open the modal
        modal.style.display = 'block';
    });
});

// Event listener for closing the modal
closeBtn.addEventListener('click', function () {
    modal.style.display = 'none';
});

// Close the modal if the user clicks outside of the modal content
window.addEventListener('click', function (event) {
    if (event.target === modal) {
        modal.style.display = 'none';
    }
});

            </script>

            
            
        
        

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
