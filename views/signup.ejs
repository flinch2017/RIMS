    width: 180px !important; /* Explicitly set width to control the button's size */
    height: 40px; /* Smaller height for the button */
    display: inline-block;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    position: relative;
    text-align: center; /* Ensures text is centered inside the button */
}
/* Hover Effect: Expands into a square with a bounce effect and increases width */
.btn-signup:hover {
    border-radius: 8px !important; /* More square-like on hover */
    width: 100% !important; /* Increase width on hover */
    transform: scale(1); /* Expands the button */
    animation: bounce 0.6s ease-out;
    background: #000000 !important;
    color: yellow !important;
}

/* Bouncy Animation for Hover */
@keyframes bounce {
    0% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1); /* Slightly more expansion during bounce */
    }
    100% {
        transform: scale(1);
