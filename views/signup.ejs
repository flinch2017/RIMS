    margin-bottom: 1.5rem;
}

/* Form Control Styling */
.form-control {
    height: 45px;
    font-size: 1rem;
    padding: 0.8rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 100%;
    transition: all 0.3s ease;
    background-color: #f9f9f9;
}

/* Focused Form Control Styling */
.form-control:focus {
    border-color: #0088cc; /* Telegram blue */
