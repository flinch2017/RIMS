                    reader.onload = async function (event) {
                        const imageData = event.target.result;
        
                        // Disable form submission while processing OCR
                        document.getElementById('signupForm').querySelector('button[type="submit"]').disabled = true;
        
                        // Show loading indicator
                        document.getElementById('loadingIndicator').style.display = 'block';
        
                        Tesseract.recognize(imageData, 'eng', {
                            logger: (m) => {
                                if (m.status === 'recognizing text') {
                                    const progress = Math.round(m.progress * 100);
                                    document.getElementById('progressPercentage').innerText = `${progress}%`;
                                    document.getElementById('progressBar').style.width = `${progress}%`;
                                    document.getElementById('progressBar').setAttribute('aria-valuenow', progress);
                                }
                            }
                        })
                            .then(({ data: { text } }) => {
                                console.log("Extracted Text:", text);
        
                                // Extract faculty ID
                                const idMatch = text.match(/\bESSU[-\w\d]+-\d{2,4}-\d{4}\b/);
                                if (idMatch) {
                                    document.getElementById("extractedId").value = idMatch[0]; 
                                } else {
                                    document.getElementById("extractedId").value = "ID not detected";
                                }
                            })
                            .finally(() => {
                                // Hide loading indicator
                                document.getElementById('loadingIndicator').style.display = 'none';
        
                                // Re-enable form submission after OCR completes
                                document.getElementById('signupForm').querySelector('button[type="submit"]').disabled = false;
                            })
                            .catch(error => {
                                console.error("OCR Error:", error);
                                document.getElementById("extractedId").value = "OCR Error";
                            });
                    };
                    reader.readAsDataURL(file);
                }
            });
        </script>



