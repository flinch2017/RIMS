<script>
// Handle ESSU Faculty ID upload
document.getElementById('facultyIDPic').addEventListener('change', function(event) {
    const file = event.target.files[0];
    const previewContainer = document.getElementById('uploadedIDPreview');
    
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const imgElement = document.createElement('img');
            imgElement.src = e.target.result;
            imgElement.style.maxWidth = '200px'; // Resize the preview image
            previewContainer.innerHTML = ''; // Clear previous preview
            previewContainer.appendChild(imgElement);
        };
        reader.readAsDataURL(file);
    } else {
        previewContainer.innerHTML = '<p>No file uploaded</p>';
    }
});

// Handle Selfie upload
document.getElementById('selfieWithID').addEventListener('change', function(event) {
    const file = event.target.files[0];
    const previewContainer = document.getElementById('selfiePreview');
    
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const imgElement = document.createElement('img');
            imgElement.src = e.target.result;
            imgElement.style.maxWidth = '200px'; // Resize the preview image
            previewContainer.innerHTML = ''; // Clear previous preview
            previewContainer.appendChild(imgElement);
        };
        reader.readAsDataURL(file);
    } else {
        previewContainer.innerHTML = '<p>No selfie taken</p>';
    }
});

    // Load face-api.js library (ensure you include the script in your HTML)
const script = document.createElement('script');
script.src = 'https://cdn.jsdelivr.net/npm/face-api.js';
document.head.appendChild(script);

script.onload = () => {
    // Load models for face-api.js
    Promise.all([
        faceapi.nets.ssdMobilenetv1.loadFromUri('/models'),
        faceapi.nets.faceLandmark68Net.loadFromUri('/models'),
        faceapi.nets.faceRecognitionNet.loadFromUri('/models')
    ]).then(startApp);
};

function startApp() {
    // Handle ESSU Faculty ID upload
    document.getElementById('facultyIDPic').addEventListener('change', async function(event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById('uploadedIDPreview');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = async function(e) {
                const img = new Image();
                img.src = e.target.result;
                
                img.onload = async () => {
                    previewContainer.innerHTML = '';
                    previewContainer.appendChild(img);
                    
                    // Detect faces in the uploaded image
                    const detections = await faceapi.detectAllFaces(img).withFaceLandmarks().withFaceDescriptors();
                    if (detections.length > 0) {
                        console.log("Face detected in ESSU Faculty ID");
                    } else {
                        console.log("No face detected in ESSU Faculty ID");
                    }
                };
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.innerHTML = '<p>No file uploaded</p>';
        }
    });

    // Handle Selfie upload
    document.getElementById('selfieWithID').addEventListener('change', async function(event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById('selfiePreview');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = async function(e) {
                const img = new Image();
                img.src = e.target.result;
                
                img.onload = async () => {
                    previewContainer.innerHTML = '';
                    previewContainer.appendChild(img);

                    // Detect faces in the selfie
                    const detections = await faceapi.detectAllFaces(img).withFaceLandmarks().withFaceDescriptors();
                    if (detections.length > 0) {
                        console.log("Face detected in selfie");

                        // Compare the faces of the ESSU Faculty ID and the selfie
                        compareFaces(detections, file);
                    } else {
                        console.log("No face detected in selfie");
                    }
                };
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.innerHTML = '<p>No selfie taken</p>';
        }
    });

    // Function to compare faces
    async function compareFaces(detections, selfieFile) {
        // Get the descriptors from the uploaded ESSU Faculty ID image
        const img = document.getElementById('uploadedIDPreview').querySelector('img');
        const idDetections = await faceapi.detectAllFaces(img).withFaceLandmarks().withFaceDescriptors();

        if (idDetections.length > 0 && detections.length > 0) {
            // Compare the face descriptors
            const faceMatcher = new faceapi.FaceMatcher(idDetections, 0.6);
            const bestMatch = faceMatcher.findBestMatch(detections[0].descriptor);
            
            if (bestMatch.label === 'unknown') {
                alert('No matching face detected. Please retake the selfie.');
            } else {
                alert('Face match confirmed!');
            }
        } else {
            alert('No faces detected in the uploaded ESSU Faculty ID or the selfie.');
        }
    }
}

</script>

