<script>
    document.addEventListener('DOMContentLoaded', () => {
        fetch('/notifications')
            .then(response => response.json())
            .then(data => {

                
                const notificationList = document.getElementById('notificationList');
                notificationList.innerHTML = '';

                if (data.length === 0) {
                    notificationList.innerHTML = '<p class="text-center">No new notifications</p>';
                } else {
                    // Sort notifications from latest to oldest based on the actual created_at timestamp
                    data.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

                    data.forEach(notification => {
                        const notificationItem = document.createElement('div');
                        notificationItem.classList.add('notification-item');
                        notificationItem.setAttribute('data-follower-id', notification.follower_id);

                        let message = '';
                        if (notification.type === 'follow_request') {
                            message = `<strong>${notification.fullname}</strong> requested to follow you`;
                        } else if (notification.type === 'follow_accepted') {
                            message = `<strong>${notification.fullname}</strong> accepted your follow request`;
                        } else if (notification.type === 'research_approval') {
                            message = `Your request for <strong>${notification.title}</strong> as <strong>${notification.status_name}</strong> has been approved!`;
                        }

                        const messageElem = document.createElement('p');
                        messageElem.innerHTML = message;
                        notificationItem.appendChild(messageElem);

                        if (notification.type === 'follow_request') {
                            const buttonGroup = document.createElement('div');
                            buttonGroup.classList.add('button-group');

                            const acceptButton = document.createElement('button');
                            acceptButton.classList.add('accept-button');
                            acceptButton.innerText = 'Accept';
                            acceptButton.addEventListener('click', () => handleFollowRequest(notification.follower_id, 'accept', acceptButton));
                            buttonGroup.appendChild(acceptButton);

                            const rejectButton = document.createElement('button');
                            rejectButton.classList.add('reject-button');
                            rejectButton.innerText = 'Reject';
                            rejectButton.addEventListener('click', () => handleFollowRequest(notification.follower_id, 'reject', rejectButton));
                            buttonGroup.appendChild(rejectButton);

                            notificationItem.appendChild(buttonGroup);
                        }

                        // Display the time ago
                        const timeAgo = document.createElement('p');
                        timeAgo.classList.add('time-ago');
                        timeAgo.textContent = notification.timeAgo;
                        notificationItem.appendChild(timeAgo);

                        notificationList.appendChild(notificationItem);
                    });
                }
            })
            .catch(error => console.error('Error fetching notifications:', error));

        // Clear all notifications without confirmation
const clearAllBtn = document.getElementById('clearAllBtn');
clearAllBtn.addEventListener('click', async () => {
    try {
        const response = await fetch('/clear-notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            document.getElementById('notificationList').innerHTML = '<p class="text-center">No new notifications</p>';
        } else {
            alert('Failed to clear notifications');
        }
    } catch (error) {
        console.error('Error clearing notifications:', error);
        alert('Something went wrong while clearing notifications');
    }
});

    });

    async function handleFollowRequest(followerId, action, button) {
        try {
            const endpoint = action === 'accept' ? '/accept-follow-request' : '/reject-follow-request';
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ followerId })
            });

            const result = await response.json();

            if (response.ok) {
                button.innerText = action === 'accept' ? 'Accepted' : 'Rejected';
                button.style.filter = 'grayscale(100%)';
                button.disabled = true;

                const notificationItem = button.closest('.notification-item');
                const otherButton = notificationItem.querySelector(action === 'accept' ? '.reject-button' : '.accept-button');

                if (otherButton) {
                    otherButton.remove();
                }

                setTimeout(() => {
                    notificationItem.remove();
                }, 3000);
            } else {
                alert(`Error: ${result.error}`);
            }
        } catch (error) {
            console.error(`Error processing ${action} follow request:`, error);
            alert('Something went wrong. Please try again.');
        }
    }
</script>








    







    

    
    <!-- Message Modal -->
<div id="messageModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('messageModal')">&times;</span>

        <div class="messenger-container">
            <!-- Left Sidebar (Contacts) -->
            <div class="contacts-panel">
                <h3>Contacts</h3>

                <!-- Search Bar -->
                <input type="text" id="searchContacts" placeholder="Search contacts..." onkeyup="searchContacts()">

                <ul id="contactList">
                    <!-- Contacts will be dynamically generated here -->
                </ul>
            </div>

            <!-- Right Chat Panel -->
            <div class="chat-panel">
                <div id="chatHeader">Select a conversation</div>
                <div id="chatBox">
                    <p class="chat-message">Click on a contact to start chatting.</p>
                </div>
                <div class="chat-input">
                    <input type="text" id="messageInput" placeholder="Type a message...">
                    <button onclick="sendMessage()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    // Function to search users and display them
    function searchContacts() {
        let input = document.getElementById('searchContacts').value.toLowerCase();
        let contactList = document.getElementById('contactList');
        contactList.innerHTML = '';  // Clear previous results
    
        // Fetch all users from the database that match the search term
        fetch('/search-users?query=' + input)
            .then(response => response.json())
            .then(data => {
                data.users.forEach(user => {
                    // Render each user as a list item with a follow button
                    let li = document.createElement('li');
                    li.innerHTML = `
                        <img src="${user.profilePic}" alt="${user.fullname}">
                        <span>${user.fullname}</span>
                        <button onclick="followUser('${user.idnumber}')">Follow</button>
                    `;
                    contactList.appendChild(li);
                });
            });
    }
    
    // Function to follow a user (will send POST request to backend)
    function followUser(followeeId) {
        fetch('/follow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ followee_idnumber: followeeId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            console.error('Error following user:', error);
        });
    }
    </script>
    




















        <script>
            let selectedUser = "";

        // Open chat with selected contact
        function openChat(user) {
            selectedUser = user;
            document.getElementById("chatHeader").textContent = user;
            document.getElementById("chatBox").innerHTML = `<p class="chat-message received">Chat with ${user}.</p>`;
        }

        // Send message
        function sendMessage() {
            if (!selectedUser) return alert("Select a contact first!");
            
            let messageInput = document.getElementById("messageInput");
            if (messageInput.value.trim() !== "") {
                let chatBox = document.getElementById("chatBox");

                // Create new message element
                let newMessage = document.createElement("p");
                newMessage.className = "chat-message sent"; // Sent messages appear on the right
                newMessage.textContent = messageInput.value;
                
                // Append message to chat
                chatBox.appendChild(newMessage);
                messageInput.value = "";
                chatBox.scrollTop = chatBox.scrollHeight;

                // Simulate response (optional)
                setTimeout(() => {
                    let receivedMessage = document.createElement("p");
                    receivedMessage.className = "chat-message received"; // Received messages appear on the left
                    receivedMessage.textContent = "This is a reply from " + selectedUser;
                    chatBox.appendChild(receivedMessage);
                    chatBox.scrollTop = chatBox.scrollHeight;
                }, 1000);
            }
        }


        </script>

            
            <script>
                // Function to Open a Modal
        function openModal(modalId) {
            document.getElementById(modalId).style.display = "block";
        }

        // Function to Close a Modal
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = "none";
        }

        // Close the modal if user clicks outside
        window.onclick = function(event) {
            if (event.target.classList.contains("modal")) {
                event.target.style.display = "none";
            }
        }

    </script>
    
    
