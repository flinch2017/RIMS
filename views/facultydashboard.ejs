    <style>
       /* General Dashboard Styling */
.main-content {
    margin-left: 220px; /* Increased to account for the sidebar */
    flex-grow: 1;
    width: 100%;
    animation: fadeIn 1s ease-in-out;
    padding: 20px; /* Reduced padding */
}

/* Welcome Text Styling */
.welcome {
    font-size: 1.25rem; /* Keep the smaller font size */
    font-weight: bold;
    color: #2e7d32; /* Dark Green */
    margin-bottom: 15px; /* Maintain spacing */
    display: flex;
    align-items: center;
    gap: 8px; /* Space between icon and text */
    animation: fadeIn 1.5s ease-in-out;
}

/* Icon Styling */
.welcome i {
    font-size: 1.5rem; /* Slightly bigger than text */
    color: #66bb6a; /* Lighter Green */
    animation: bounce 1.5s infinite alternate;
}

/* Fade-in animation */
@keyframes fadeIn {
    0% { opacity: 0; transform: translateY(-5px); }
    100% { opacity: 1; transform: translateY(0); }
}

/* Bouncing effect for the sun/moon */
@keyframes bounce {
    0% { transform: translateY(0); }
    100% { transform: translateY(-3px); }
}



/* Main Title Styling */
h1.my-4 {
    font-size: 2rem; /* Smaller font size */
    color: #000000;
    font-weight: 600;
    text-align: left;
    animation: fadeIn 2s ease-in-out;
}

/* Grid Layout for Cards */
.grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}

/* Responsive Layout */
@media(min-width: 768px) {
    .grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Card Styling */
.card {
    background: #fff;
    padding: 15px; /* Reduced padding */
    border-radius: 8px; /* Slightly smaller radius */
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Reduced shadow */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: slideUp 0.5s ease-out;
}

/* Hover Effect for Cards */
.card:hover {
    transform: translateY(-8px); /* Less pronounced hover */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12); /* Softer shadow */
}

/* Card Title */
.card-title {
    font-size: 1.125rem; /* Smaller font size */
    color: #343a40;
    font-weight: 500;
    margin-bottom: 8px; /* Adjusted margin */
}

/* Card Count Styling */
.card-count {
    font-size: 1.5rem; /* Smaller font size */
    font-weight: bold;
    color: #000000;
}

/* Specific Colors for Different Research Types */
.total-research {
    background-color: #f8f9fa;
    border-left: 5px solid #66bb6a;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
    animation-delay: 0.2s; /* Delay for this card */
}

.proposed-research {
    background-color: #f8f9fa;
    border-left: 5px solid #66bb6a;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
    animation-delay: 0.4s; /* Delay for this card */
}

.completed-research {
    background-color: #f8f9fa;
    border-left: 5px solid #66bb6a;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
    animation-delay: 0.6s; /* Delay for this card */
}

.ongoing-research {
    background-color: #f8f9fa;
    border-left: 5px solid #66bb6a;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
    animation-delay: 0.8s; /* Delay for this card */
}

.published-research {
    background-color: #f8f9fa;
    border-left: 5px solid #66bb6a;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
    animation-delay: 1s; /* Delay for this card */
}

/* Animation for Cards to Appear */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px); /* Start lower */
    }
    to {
        opacity: 1;
        transform: translateY(0); /* End in place */
    }
}


/* Animation for Fade-In */
@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

/* Animation for Sliding Up */
@keyframes slideUp {
    from {
        transform: translateY(10px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes bounceHover {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1.05); }
}

