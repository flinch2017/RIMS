                            type="text" 
                            name="search" 
                            class="form-control" 
                            placeholder="Search by Title, Author, or Description" 
                            value="<%= searchQuery || '' %>">
                            <button type="submit" class="btn btn-green ms-2 search-btn">
                                <i class="fas fa-search"></i>
                            </button>
                            
                              
                       
                        
                    </form>



 

            
                    
                    
                </div>
                <div class="aligned-container">
