                    <a href="/logout"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Notification Modal -->
    <div id="notificationModal" class="notif-modal">
        <div class="notif-modal-content">
            <span class="close" onclick="closeModal('notificationModal')">&times;</span>
            <h2>Notifications</h2>
            <button id="clearAllBtn" class="clear-all-btn">Clear All Notifications</button>
            <div id="notificationList">
                <!-- Notifications will be dynamically generated here -->
            </div>
        </div>
    </div>

    
