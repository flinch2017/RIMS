                            data-bs-toggle="modal" 
                            data-bs-target="#uploadResearchModal"
                            <% if (userMode === 'Pending' || userMode === 'Rejected') { %>
                                style="filter: grayscale(100%); cursor: not-allowed;" 
                                disabled
                            <% } %>
