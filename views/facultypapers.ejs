                <i class="fas fa-book"></i> <span>Researches</span>
            </a>
        </div>

        <div class="main-content">
            <div class="container">
                <h1 class="my-4 researches-heading">
                    <i class="fas fa-book-open"></i> Researches
                </h1>
                
                <!-- Filter and Search Section -->
                <div class="d-flex align-items-center mb-4">
                    <!-- Search Bar -->
                    <form method="GET" action="/facultypapers" class="d-flex me-3">
