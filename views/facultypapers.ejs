<script>
    document.addEventListener('DOMContentLoaded', () => {
        fetch('/notifications')
            .then(response => response.json())
            .then(data => {

                
                const notificationList = document.getElementById('notificationList');
                notificationList.innerHTML = '';

                if (data.length === 0) {
                    notificationList.innerHTML = '<p class="text-center">No new notifications</p>';
                } else {
                    // Sort notifications from latest to oldest based on the actual created_at timestamp
                    data.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

                    data.forEach(notification => {
                        const notificationItem = document.createElement('div');
                        notificationItem.classList.add('notification-item');
                        notificationItem.setAttribute('data-follower-id', notification.follower_id);

                        let message = '';
                        if (notification.type === 'follow_request') {
                            message = `<strong>${notification.fullname}</strong> requested to follow you`;
                        } else if (notification.type === 'follow_accepted') {
                            message = `<strong>${notification.fullname}</strong> accepted your follow request`;
                        } else if (notification.type === 'research_approval') {
                            message = `Your request for <strong>${notification.title}</strong> as <strong>${notification.status_name}</strong> has been approved!`;
                        }

                        const messageElem = document.createElement('p');
                        messageElem.innerHTML = message;
                        notificationItem.appendChild(messageElem);

                        if (notification.type === 'follow_request') {
                            const buttonGroup = document.createElement('div');
                            buttonGroup.classList.add('button-group');

                            const acceptButton = document.createElement('button');
                            acceptButton.classList.add('accept-button');
                            acceptButton.innerText = 'Accept';
                            acceptButton.addEventListener('click', () => handleFollowRequest(notification.follower_id, 'accept', acceptButton));
                            buttonGroup.appendChild(acceptButton);

                            const rejectButton = document.createElement('button');
                            rejectButton.classList.add('reject-button');
                            rejectButton.innerText = 'Reject';
                            rejectButton.addEventListener('click', () => handleFollowRequest(notification.follower_id, 'reject', rejectButton));
                            buttonGroup.appendChild(rejectButton);

                            notificationItem.appendChild(buttonGroup);
                        }

                        // Display the time ago
                        const timeAgo = document.createElement('p');
                        timeAgo.classList.add('time-ago');
                        timeAgo.textContent = notification.timeAgo;
                        notificationItem.appendChild(timeAgo);

