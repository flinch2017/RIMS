<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>My Researches - ESSU Research and Information Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #e8f5e9;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        
        url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2220%22 height=%2220%22 viewBox=%220 0 20 20%22%3E%3Cpath fill=%22%23e0e0e0%22 d=%22M0 0h2v2H0zm2 2h2v2H2zm2 2h2v2H4zm2 2h2v2H6zm2 2h2v2H8zm2 2h2v2H10zm2 2h2v2H12zm2 2h2v2H14z%22/%3E%3C/svg%3E') repeat;
    background-size: 450px, 30px 30px; /* Larger checkered pattern for a more refined look */
    background-position: center, 0 0; /* Logo stays centered, checkered pattern starts at the top */
    opacity: 0.9; /* Slightly faded to make it softer */
    z-index: -1; /* Place it behind other content */
    animation: fadeAnimation 15s ease-in-out infinite, moveCheckered 10s linear infinite; /* Fading + vertical move */
}

/* Keyframes for fading effect */
@keyframes fadeAnimation {
    0%, 100% { opacity: 0.9; } /* Keep the opacity at a subtle level */
    50% { opacity: 0.4; }   /* Faded in the middle for a smooth transition */
}

/* Keyframes for moving only the checkered pattern vertically */
@keyframes moveCheckered {
    0% { background-position: center, 0 0; }  /* Start at the top */
    100% { background-position: center, 0 100%; }  /* Move to the bottom */
}

        .header {
            background: linear-gradient(90deg, #008000, #66bb6a);
            color: white;
            padding: 0.75rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            font-size: 1rem;
        }
        .header .brand {
            font-size: 1.25rem;
            font-weight: 600;
        }
        .header .btn-profile,
        .header .btn-logout {
            background-color: #ffffff;
            color: #2e7d32;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
            margin-right: 10px;
        }
        .header .btn-profile:hover,
        .header .btn-logout:hover {
            background-color: #f1f1f1;
            color: #2e7d32;
        }
        .header .btn-add-research {
            background-color: #ffffff;
            color: #2e7d32;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s, color 0.3s;
        }
        .header .btn-add-research:hover {
            background-color: #f1f1f1;
            color: #2e7d32;
        }
        .dashboard-container {
            margin-top: 60px;
            display: flex;
            flex-wrap: wrap;
        }
        .sidebar {
            width: 220px;
            background-color: #66bb6a;
            padding-top: 15px;
            position: fixed;
            top: 60px;
            left: 0;
            height: calc(100% - 60px);
            overflow-y: auto;
            z-index: 900;
        }

        .sidebar a {
    display: flex;
    align-items: center;
    color: white;
    padding: 0.8rem;
    text-decoration: none;
    font-size: 1rem;
    transition: background-color 0.3s ease, color 0.15s ease; /* Faster color transition */
}

/* Ensure both icon and text get the hover effect */
.sidebar a i, 
.sidebar a span {
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), color 0.15s ease; /* Faster color transition */
    display: inline-block; /* Smooth scaling */
}

/* Add spacing between icon and text */
.sidebar a i {
    margin-right: 12px; /* Adjust as needed */
    font-size: 1.2rem;  /* Slightly larger for balance */
}

/* More subtle enlarge & push to right effect, plus color change */
.sidebar a:hover {
    color: rgb(255, 255, 255); /* Change text & icon color */
}

.sidebar a:hover i, 
.sidebar a:hover span {
    transform: scale(1.08) translateX(4px); /* Gentle scaling & movement */
}
        .main-content {
            margin-left: 220px;
            padding: 1rem;
            flex-grow: 1;
            width: calc(100% - 220px);
            font-size: 0.85rem;
        }
        .search-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .search-bar form {
            display: flex;
            align-items: center;
            width: 100%;
        }
        .input-group {
            display: flex;
            align-items: center;
            flex-grow: 1;
        }
        .d-flex {
            display: flex;
        }
        .ml-3 {
            margin-left: 1rem;
        }

        /* Table container styling */
.research-table-container {
    animation: fadeIn 1s ease-in-out;
}

/* Table Styling */
#research-table {
    border-collapse: collapse;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    background-color: #fff;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    animation: slideUp 0.5s ease-out;
}

/* Header Styling */
#research-table thead {
    background-color: #007bff;
    color: white;
    font-weight: bold;
}

/* Table Row Styling */
#research-table tbody tr {
    opacity: 0;
    transition: background-color 0.3s ease, opacity 0.5s ease;
}

#research-table tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.1);
}

/* Row Fade-In Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

#research-table tbody tr.animate {
    animation: fadeIn 1s forwards;
}

/* Pagination Styling */
.pagination-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 20px;
}

.pagination-controls button {
    padding: 8px 15px;
    background-color: #007bff;
    color: white;
    border-radius: 5px;
    text-decoration: none;
    transition: background-color 0.3s;
}

.pagination-controls button:hover {
    background-color: #0056b3;
}

.pagination-controls button:disabled {
    background-color: #ccc;
}

/* Buttons for View, Edit, and other actions */
.btn-sm {
    font-size: 0.8rem;
    padding: 6px 10px;
    margin-right: 5px;
}

/* Button Specific Styling */
.btn-info {
    background-color: #17a2b8;
}

.btn-info:hover {
    background-color: #138496;
}

.btn-warning {
    background-color: #ffc107;
}

.btn-warning:hover {
    background-color: #e0a800;
}

/* Table Row Slide-Up Animation */
@keyframes slideUp {
    from {
        transform: translateY(10px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

    </style>
    <style>
        #author-suggestions {
            list-style-type: none;
            padding: 0;
            margin: 0;
            border: 1px solid #ccc;
            position: absolute;
            width: max-content;
            background-color: white;
            z-index: 1000;
        }
        
        #author-suggestions .dropdown-item {
            padding: 5px 10px;
            cursor: pointer;
        }
        
        #author-suggestions .dropdown-item:hover {
            background-color: #f1f1f1;
        }
        
        .author-capsule {
            display: flex;
            align-items: center;
            padding: 5px;
            border: 1px solid #ddd;
            border-radius: 20px;
            background-color: #f0f0f0;
            font-size: 14px;
        }
        
        .author-capsule button {
            background: none;
            border: none;
            color: red;
            cursor: pointer;
            font-size: 18px;
        }

        .modal-dialog {
    max-width: 90%; /* Adjust as needed */
}

    </style>
    <style>
      

/* Publication Date Group (Hidden Initially) */
#publication_date_group {
    display: none;
}

/* Responsive Design */
@media (max-width: 768px) {
    .modal-body {
        padding: 1rem;
    }

    .modal-footer .btn {
        font-size: 0.9rem;
        padding: 0.4rem 0.8rem;
    }
}

.pagination-controls {
    display: flex;
    justify-content: center;
    margin-top: 10px;
}

.pagination-controls .btn {
    margin: 0 5px;
}


    </style>
    <style>
        .aligned-container {
    display: flex;
    justify-content: space-between; /* Ensure separation between the two elements */
    align-items: center; /* Vertically align items */
    margin-bottom: 1rem; /* Add spacing below the container */
}

.aligned-container .btn-success {
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 4px;
}

.aligned-container .form-select {
    max-width: 200px; /* Adjust the width of the dropdown */
}

.scan-button {
            width: 200px;
            margin-left: 10px;
            font-size: 1rem;
            color: #ffffff;
            background-color: #388e3c;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .scan-button:hover {
            background-color: #2e7d32;
        }

        /* Smooth fade-in animation */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

.aligned-container {
    animation: fadeIn 0.4s ease-out;
}

/* Modern button style */
.btn-primary {
    background: linear-gradient(135deg, #0088cc, #005f99);
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 500;
    transition: all 0.3s ease-in-out;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #0077b5, #004f80);
    transform: scale(1.05);
}

/* Sorting container with horizontal layout */
.sortof {
    display: flex;
    align-items: center;
    gap: 12px; /* Space between dropdowns */
    padding: 12px;
    background: #f8f9fa;
    border-radius: 12px;
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease-in-out;
}

/* Form styles */
.sortof form {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Stylish dropdowns */
.form-select {
    padding: 10px 15px;
    border-radius: 8px;
    border: 1px solid #ddd;
    background: white;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    min-width: 180px;
}

.form-select:hover {
    border-color: #0088cc;
}

/* Loading animation */
.sortof.loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out;
}

.loading-spinner {
    width: 20px;
    height: 20px;
    border: 3px solid #ccc;
    border-top: 3px solid #0088cc;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    display: none;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Animation for expanding the button into the modal */
@keyframes expandButton {
    0% {
        width: 200px; /* Start with the original button size */
        height: 50px;
        border-radius: 8px;
    }
    100% {
        width: 100vw; /* Expand the width */
        height: 100vh; /* Expand the height to cover the screen */
        border-radius: 0; /* No rounded corners */
    }
}

/* Class for the button that will animate */
.manage-btn {
    position: relative;
    display: inline-block;
    padding: 10px 20px;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
    overflow: hidden;
    z-index: 2;
}

/* When the button is clicked, it will expand */
.manage-btn.expanded {
    animation: expandButton 1s forwards; /* Button expands */
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
}

/* Modal becomes visible after animation */
#managePapersModal.show {
    display: block;
    opacity: 1;
    transition: opacity 0.5s ease-in-out;
}

#managePapersModal {
    display: none;
}


/* Researches Heading Styling */
.researches-heading {
    font-size: 1.75rem; /* Prominent size */
    font-weight: bold;
    color: #2e7d32; /* Deep green for consistency */
    display: flex;
    align-items: center;
    gap: 10px; /* Space between icon and text */
    margin-bottom: 30px;
    opacity: 0;
    transform: translateY(-10px);
    animation: fadeSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Icon Styling */
.researches-heading i {
    font-size: 2rem; /* Larger for emphasis */
    color: #2e7d32; /* Matches the heading */
    opacity: 0;
    transform: scale(0.8);
    animation: popIn 0.4s ease-out 0.2s forwards;
}

/* Smooth Fade & Slide Animation (Telegram Vibe) */
@keyframes fadeSlideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Pop-in Effect for Icon */
@keyframes popIn {
    0% {
        opacity: 0;
        transform: scale(0.8);
    }
    100% {
        opacity: 1;
        transform: scale(1);
    }
}

.text-muted {
    display: inline-flex;
    align-items: center;
    background-color: #e9ecef;
    color: #495057;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin-right: 8px;
}

    </style>


</head>
<body>

    <div class="header">
        <div class="brand" style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background-color: white;">
                <img src="/images/essu_logo.png" alt="ESSU Logo" style="width: 100%; height: auto; object-fit: contain;">
            </div>
            ESSU RIMS
        </div>
        <div class="d-flex">
            
            <button class="btn-logout" onclick="window.location.href='/logout'">Logout</button>
        </div>
    </div>

    <div class="dashboard-container">
        <div class="sidebar">
            <a href="/rdsodashboard"><i class="fas fa-tachometer-alt"></i> <span>Dashboard</span></a>
            <a href="/rdsopapers"><i class="fas fa-file-alt"></i> <span>Researches</span></a>
            <a href="/campusescolleges"><i class="fas fa-university"></i> <span>Campuses & Colleges</span></a>
            <a href="/faculties"><i class="fas fa-user-graduate"></i> <span>Faculties/Researchers</span></a>
            <a href="/requests"><i class="fas fa-envelope"></i> <span>Verification Requests</span></a>
        </div>

        <div class="main-content">
            <div class="container">
                <h1 class="researches-heading">
                    <i class="fas fa-flask"></i> Researches
                </h1>
                
                <!-- Filter and Search Section -->
                <div class="d-flex align-items-center mb-4">
                    <!-- Search Bar -->
                    <form method="GET" action="/rdsopapers" class="d-flex me-3">
                        <input 
                            type="text" 
                            name="search" 
                            class="form-control rounded-pill" 
                            placeholder="Search by Title, Author, or Description" 
                            value="<%= searchQuery || '' %>">
                        <button type="submit" class="btn btn-success ms-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                    
                    <style>
                        .form-control {
    border-radius: 50px; /* More rounded */
    padding: 10px 20px; /* Adjust padding */
}

.btn-success {
    border-radius: 50px; /* Match the input field */
    padding: 8px 15px; /* Adjust button size */
}

                    </style>



 

            
                    
                    
                </div>
                <div class="aligned-container">
                    <div class="mb-3 text-end">
                        <button class="btn btn-success rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#managePapersModal">
                            <i class="fas fa-file-alt"></i> Manage Paper Submissions
                        </button>
                    </div>
                    
                    
                    <div class="sortof">
                        <!-- Sorting Dropdowns for Status & Campus -->
                        <form method="GET" action="/rdsopapers">
                            <!-- Status Filter -->
                            <label for="status" class="visually-hidden">Filter by Status:</label>
                            <select name="status" id="status" class="form-select" onchange="this.form.submit()">
                                <option value="">All Statuses</option>
                                <% statuses.forEach(status => { %>
                                    <option value="<%= status.id %>" <%= status.id == statusFilter ? 'selected' : '' %>><%= status.name %></option>
                                <% }); %>
                            </select>
                    
                            <!-- Campus Filter -->
                            <label for="campus" class="visually-hidden">Filter by Campus:</label>
                            <select name="campus" id="campus" class="form-select" onchange="this.form.submit()">
                                <option value="">All Campuses</option>
                                <% campuses.forEach(campus => { %>
                                    <option value="<%= campus %>" <%= campus == campusFilter ? 'selected' : '' %>><%= campus %></option>
                                <% }); %>
                            </select>
                        </form>
                    </div>
                    

                </div>

                <!-- Manage Paper Submissions Modal -->
<div class="modal fade" id="managePapersModal" tabindex="-1" aria-labelledby="managePapersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-animation rounded-4 shadow-lg">
            <div class="modal-header custom-modal-header">
                <h5 class="modal-title" id="managePapersModalLabel">Manage Paper Submissions</h5>
                <button type="button" class="btn-close custom-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Author(s)</th>
                            <th>Status</th>
                            <th>Date Uploaded</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="paperSubmissionsTable">
                        <!-- Data will be inserted here via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>






<!-- View Paper Details Modal -->
<div class="modal fade" id="viewPaperModal" tabindex="-1" aria-labelledby="viewPaperModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewPaperModalLabel">View Paper Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="viewPaperDetails">
                <!-- Paper details will be inserted here via JavaScript -->
            </div>
        </div>
    </div>
</div>



    


        


<!-- Modal for Viewing Research Details -->
<div class="modal fade" id="viewResearchModal" tabindex="-1" aria-labelledby="viewResearchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg rounded-4 border-0">
            <div class="modal-header border-bottom-0 bg-success text-white">
                <h5 class="modal-title" id="viewResearchModalLabel">
                    <i class="fa-solid fa-file-lines"></i> View Research
                </h5>
                
                <!-- Print Button -->
                <button type="button" class="btn btn-light btn-sm" id="printModalContent" title="Print">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
            <div class="modal-body px-4 py-3">
                <!-- Barcode Image Display at Top Right -->
                <div class="d-flex justify-content-end mb-4">
                    <img id="view-barcode-image" src="" alt="Barcode Image" class="shadow-sm" style="max-width: 150px; height: auto;" />
                </div>

                <!-- Two-column layout for details and PDF preview -->
                <div class="row">
                    <div class="col-md-6">
                        <!-- Title Box -->
                        <div class="p-3 rounded-3 shadow-sm bg-success-subtle mb-3 text-center">
                            <h4 class="text-success">
                                <i class="fas fa-file-alt"></i> Title</h4><strong><span id="view-title" class="text-dark" style="font-size: 20px; font-weight: 700;"></span></strong>
                        </div>
                
                        <!-- Details Box -->
                        <div class="p-3 rounded-3 shadow-sm bg-success-subtle">
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-user"></i> Author</strong> <span id="view-author" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-university"></i> Campus</strong> <span id="view-campus" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-calendar-alt"></i> Publication Date</strong> <span id="view-publication-date" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-book"></i> Journal Publication</strong> <span id="view-journal-publication" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-info-circle"></i> Status</strong> <span id="view-status" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-tags"></i> Nature</strong> <span id="view-nature" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-globe"></i> Origin</strong> <span id="view-origin" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-link"></i> DOI</strong> <span id="view-doi" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-align-left"></i> Abstract</strong> <span id="view-abstract" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-money-bill-wave"></i> Funding</strong> <span id="view-funding" class="text-dark"></span></p>
                            </div>
                            <div class="mb-3">
                                <p><strong class="text-success"><i class="fas fa-barcode"></i> ISBN/ISSN</strong> <span id="view-isbn" class="text-dark"></span></p>
