         .then(data => {
             const tableBody = document.getElementById('paperSubmissionsTable');
             tableBody.innerHTML = '';
 
             if (data.length === 0) {
                 tableBody.innerHTML = '<tr><td colspan="8" class="text-center">No paper submission requests found</td></tr>';
             } else {
                 data.forEach(paper => {
                     const row = `
                         <tr>
                             <td>${paper.id}</td>
                             <td>${paper.title}</td>
                             <td>${paper.author_names || 'Unknown'}</td>
                             <td>${paper.request || 'No Request Data'}</td> 
                             <td>${new Date(paper.date_uploaded).toLocaleDateString()}</td>
                             <td>
    <button class="btn btn-info btn-sm rounded-pill view-paper-btn" data-id="${paper.id}">View</button>
    <button class="btn btn-success btn-sm rounded-pill update-status-btn" data-id="${paper.id}" data-status="${paper.request}">Approve</button>
    <button class="btn btn-danger btn-sm rounded-pill reject-status-btn" data-id="${paper.id}">Reject</button>
</td>

                         </tr>
                     `;
                     tableBody.innerHTML += row;
                 });
 
                 // View button event listener
                 document.querySelectorAll('.view-paper-btn').forEach(button => {
                     button.addEventListener('click', function () {
                         const paperId = this.getAttribute('data-id');
                         viewPaperDetails(paperId);
                     });
                 });
 
                 // Approve button event listener
                 document.querySelectorAll('.update-status-btn').forEach(button => {
                     button.addEventListener('click', function () {
                         const paperId = this.getAttribute('data-id');
                         let currentStatus = this.getAttribute('data-status');
 
                         if (currentStatus.startsWith("Request for ")) {
                             const newStatus = currentStatus.replace("Request for ", "Current ");
                             updatePaperStatus(paperId, newStatus);
                         } else {
                             alert("This request has already been approved.");
                         }
                     });
                 });
 
                 // Reject button event listener
                 document.querySelectorAll('.reject-status-btn').forEach(button => {
                     button.addEventListener('click', function () {
                         alert("Request rejected."); // Modify as needed
                     });
                 });
             }
         })
         .catch(error => console.error('Error fetching paper submissions:', error));
 });
 
 // Function to update paper submission status
 function updatePaperStatus(id, newStatus) {
     fetch('/update-paper-status', {
         method: 'POST',
         headers: {
             'Content-Type': 'application/json'
         },
         body: JSON.stringify({ id, request: newStatus })
     })
     .then(response => response.json())
     .then(data => {
         if (data.success) {
             location.reload(); // Refresh to update the table
         } else {
             alert('Error updating status');
         }
     })
     .catch(error => console.error('Error updating paper status:', error));
 }
 
 
 
 // Function to fetch and display paper details
function viewPaperDetails(id) {
    fetch(`/get-paper-details/${id}`)
        .then(response => response.json())
        .then(data => {
            if (data) {
                const modalBody = document.getElementById('viewPaperDetails');

                let pdfPreview = '';
                if (data.filename && data.filename !== "Not available") {
                    pdfPreview = `
                        <embed src="/uploads/${data.filename}" type="application/pdf" width="100%" height="500px" style="border: 1px solid #ddd;"/>
                    `;
                } else {
                    pdfPreview = `
                        <div class="d-flex flex-column align-items-center justify-content-center text-center p-5 border rounded bg-light" style="height: 500px;">
                            <i class="fa-solid fa-file-circle-xmark text-danger" style="font-size: 3rem;"></i>
                            <p class="mt-2 text-muted">This paper has no PDF attached.</p>
                        </div>
                    `;
                }

                // Function to create a field only if it has valid content with FontAwesome icons
                function createField(icon, label, value) {
                    if (!value || value === "Not available" || value === "Unknown") {
                        return "";
                    }
                    return `<p><i class="fa-solid ${icon} text-primary"></i> <strong>${label}:</strong> ${value}</p>`;
                }

                modalBody.innerHTML = `
                    <div class="row">
                        <!-- Left Column (Research Details) -->
                        <div class="col-md-6">
                            <h4><i class="fa-solid fa-book text-success"></i> <strong>${data.title}</strong></h4>

                            ${createField("fa-user", "Author(s)", data.author_names)}
                            ${createField("fa-list-check", "Status", data.request)}
                            ${createField("fa-calendar-day", "Uploaded Date", new Date(data.date_uploaded).toLocaleDateString())}
                            ${createField("fa-file-lines", "Abstract", data.abstract)}
                            ${createField("fa-calendar", "Publication Date", data.publication_date)}
                            ${createField("fa-newspaper", "Journal", data.journal_publication)}
                            ${createField("fa-globe", "Origin", data.origin)}
                            ${createField("fa-seedling", "Nature", data.nature)}
                            ${createField("fa-dollar-sign", "Funding", data.funding)}
                            ${createField("fa-barcode", "ISBN", data.isbn)}
                            ${createField("fa-id-card", "DOI", data.doi)}
                            ${createField("fa-key", "Keywords", data.keyword)}
                            ${createField("fa-file", "Filename", data.filename)}
                        </div>

                        <!-- Right Column (PDF Preview) -->
                        <div class="col-md-6">
                            ${pdfPreview}
                        </div>
                    </div>
                `;

                // Show the modal
                new bootstrap.Modal(document.getElementById('viewPaperModal')).show();
            }
        })
        .catch(error => console.error('Error fetching paper details:', error));
}


 
     </script>


