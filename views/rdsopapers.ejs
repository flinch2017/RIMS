            <a href="/rdsodashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a href="/rdsopapers"><i class="fas fa-file-alt"></i> Researches</a>
            <a href="/campusescolleges"><i class="fas fa-university"></i> Campuses & Colleges</a>
            <a href="/faculties"><i class="fas fa-user-graduate"></i> Faculties/Researchers</a>
            <a href="/requests"><i class="fas fa-envelope"></i> Verification Requests</a>
        </div>

        <div class="main-content">
            <div class="container">
                <h1 class="my-4">Researches</h1>
                <!-- Filter and Search Section -->
                <div class="d-flex align-items-center mb-4">
                    <!-- Search Bar -->
                    <form method="GET" action="/rdsopapers" class="d-flex me-3">
                        <input 
                            type="text" 
                            name="search" 
                            class="form-control" 
                            placeholder="Search by Title, Author, or Description" 
                            value="<%= searchQuery || '' %>">
                        <button type="submit" class="btn btn-primary ms-2">Search</button>
                       
                        
                    </form>



 

            
                    
                    
                </div>
                <div class="aligned-container">
                    <div class="mb-3 text-end">
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#managePapersModal">
                            <i class="fas fa-file-alt"></i> Manage Paper Submissions
                        </button>
                    </div>
                    
                    <div class="sortof">
                        <!-- Sorting Dropdowns for Status & Campus -->
                        <form method="GET" action="/rdsopapers">
                            <!-- Status Filter -->
                            <label for="status" class="visually-hidden">Filter by Status:</label>
                            <select name="status" id="status" class="form-select" onchange="this.form.submit()">
                                <option value="">All Statuses</option>
                                <% statuses.forEach(status => { %>
                                    <option value="<%= status.id %>" <%= status.id == statusFilter ? 'selected' : '' %>><%= status.name %></option>
                                <% }); %>
                            </select>
                    
                            <!-- Campus Filter -->
                            <label for="campus" class="visually-hidden">Filter by Campus:</label>
                            <select name="campus" id="campus" class="form-select" onchange="this.form.submit()">
                                <option value="">All Campuses</option>
                                <% campuses.forEach(campus => { %>
                                    <option value="<%= campus %>" <%= campus == campusFilter ? 'selected' : '' %>><%= campus %></option>
                                <% }); %>
                            </select>
                        </form>
                    </div>
                    

                </div>

                <!-- Manage Paper Submissions Modal -->
<div class="modal fade" id="managePapersModal" tabindex="-1" aria-labelledby="managePapersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="managePapersModalLabel">Manage Paper Submissions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Author(s)</th>
                            <th>Status</th>
                            <th>Date Uploaded</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="paperSubmissionsTable">
                        <!-- Data will be inserted here via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- View Paper Details Modal -->
<div class="modal fade" id="viewPaperModal" tabindex="-1" aria-labelledby="viewPaperModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewPaperModalLabel">View Paper Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="viewPaperDetails">
                <!-- Paper details will be inserted here via JavaScript -->
            </div>
        </div>
    </div>
</div>


<script>
   document.addEventListener('DOMContentLoaded', () => {
    fetch('/paper-submissions-requests')
        .then(response => response.json())
        .then(data => {
            const tableBody = document.getElementById('paperSubmissionsTable');
            tableBody.innerHTML = '';

            if (data.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="8" class="text-center">No paper submission requests found</td></tr>';
            } else {
                data.forEach(paper => {
                    const row = `
                        <tr>
                            <td>${paper.id}</td>
                            <td>${paper.title}</td>
                            <td>${paper.author_names || 'Unknown'}</td>
                            <td>${paper.request || 'No Request Data'}</td> 
                            <td>${new Date(paper.date_uploaded).toLocaleDateString()}</td>
                            <td>
                                <button class="btn btn-info btn-sm view-paper-btn" data-id="${paper.id}">View</button>
                                <button class="btn btn-success btn-sm update-status-btn" data-id="${paper.id}" data-status="${paper.request}">Approve</button>
                                <button class="btn btn-danger btn-sm reject-status-btn" data-id="${paper.id}">Reject</button>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });

                // View button event listener
                document.querySelectorAll('.view-paper-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        const paperId = this.getAttribute('data-id');
                        viewPaperDetails(paperId);
                    });
                });

                // Approve button event listener
                document.querySelectorAll('.update-status-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        const paperId = this.getAttribute('data-id');
                        let currentStatus = this.getAttribute('data-status');

                        if (currentStatus.startsWith("Request for ")) {
                            const newStatus = currentStatus.replace("Request for ", "Current ");
                            updatePaperStatus(paperId, newStatus);
                        } else {
                            alert("This request has already been approved.");
                        }
                    });
                });

                // Reject button event listener
                document.querySelectorAll('.reject-status-btn').forEach(button => {
                    button.addEventListener('click', function () {
                        alert("Request rejected."); // Modify as needed
                    });
                });
            }
        })
        .catch(error => console.error('Error fetching paper submissions:', error));
});

// Function to update paper submission status
function updatePaperStatus(id, newStatus) {
    fetch('/update-paper-status', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id, request: newStatus })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload(); // Refresh to update the table
        } else {
            alert('Error updating status');
        }
    })
    .catch(error => console.error('Error updating paper status:', error));
}




// Function to fetch and display paper details
function viewPaperDetails(id) {
    fetch(`/get-paper-details/${id}`)
        .then(response => response.json())
        .then(data => {
            if (data) {
                const modalBody = document.getElementById('viewPaperDetails');
                modalBody.innerHTML = `
                    <h4>Title: ${data.title}</h4>
                    <p><strong>Author(s):</strong> ${data.author_names || 'Unknown'}</p>
                    <p><strong>Status:</strong> ${data.request}</p>
                    <p><strong>Uploaded Date:</strong> ${new Date(data.date_uploaded).toLocaleDateString()}</p>
                    <p><strong>Abstract:</strong> ${data.abstract || 'No abstract available'}</p>
                    <p><strong>DOI:</strong> ${data.doi || 'Not available'}</p>
                    <p><strong>Publication Date:</strong> ${data.publication_date || 'Not available'}</p>
                    <p><strong>Journal:</strong> ${data.journal_publication || 'Not available'}</p>
                    <p><strong>Funding:</strong> ${data.funding || 'Not available'}</p>
                    <p><strong>ISBN:</strong> ${data.isbn || 'Not available'}</p>
                    <p><strong>Keywords:</strong> ${data.keyword || 'Not available'}</p>
                `;

                // Show the modal
                new bootstrap.Modal(document.getElementById('viewPaperModal')).show();
            }
        })
        .catch(error => console.error('Error fetching paper details:', error));
}

    </script>
    


        


